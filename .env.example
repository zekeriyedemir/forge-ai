DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forge?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/forge?schema=public"
AUTH_SECRET="replace-with-a-random-secret-at-least-32-characters-long"
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# AUTH_URL is usually inferred by Auth.js v5. Set it only for a custom base path.
# AUTH_URL="http://localhost:3000"
# Set only behind your own trusted reverse proxy. Vercel detects this automatically.
# AUTH_TRUST_HOST="true"
# Local development only: enables a shared disposable account and deterministic AI.
# Production always requires sign-in. The public /demo needs no credentials or database.
DEMO_MODE="false"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# Zero-cost local development option: run your own SearXNG instance and point Forge at it.
# This is the recommended development provider and does not require a paid API key or card.
# Start Docker, run npm run research:start, then set provider=searxng and URL=http://localhost:8080.
RESEARCH_PROVIDER="auto"
RESEARCH_SEARXNG_BASE_URL=""
# Optional paid provider. Brave remains optional and is not required for local dev.
BRAVE_SEARCH_API_KEY=""
# Developer proposals need complete file contents; use a model that supports this output budget.
DEVELOPER_PROPOSAL_MAX_COMPLETION_TOKENS="8192"
