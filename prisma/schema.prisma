generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AgentType {
  FOUNDER
  RESEARCH
  DEVELOPER
  ANALYST
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum IntegrationType {
  GITHUB
}

enum ApprovalAction {
  IMPLEMENT
  FIX
  ADOPT
  MERGE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  EXECUTING
  REJECTED
  EXECUTED
  FAILED
}

enum DeveloperStatus {
  PROPOSED
  BRANCH_CREATED
  COMMITTED
  PR_OPEN
  EXTERNAL_CHANGE
  MERGED
  FAILED
}

enum DeveloperHeadSource {
  FORGE
  EXTERNAL
}

enum ResearchStatus {
  COMPLETED
  FAILED
}

enum ResearchArea {
  MARKET
  COMPETITORS
  PRICING
  CUSTOMER_PAIN
  CUSTOMER_SEGMENTS
  DEMAND
  POSITIONING
  DISTRIBUTION
  OPPORTUNITY
}

model User {
  id            String            @id @default(uuid())
  name          String?
  email         String?           @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  memberships   WorkspaceMember[]
  requestedApprovals ApprovalRequest[] @relation("RequestedApprovals")
  decidedApprovals ApprovalRequest[] @relation("DecidedApprovals")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Workspace {
  id           String            @id @default(uuid())
  name         String
  members      WorkspaceMember[]
  projects     Project[]
  integrations Integration[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  userId      String
  role        String    @default("OWNER")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id           String             @id @default(uuid())
  workspaceId  String
  name         String
  description  String             @default("") @db.Text
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goals        BusinessGoal[]
  agents       Agent[]
  runs         AgentRun[]
  tasks        Task[]
  reports      Report[]
  metrics      Metric[]
  repositories GitHubRepository[]
  activity     ActivityEvent[]
  approvals    ApprovalRequest[]
  executions   DeveloperExecution[]
  researchSessions ResearchSession[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([workspaceId, createdAt])
}

model BusinessGoal {
  id        String   @id @default(uuid())
  projectId String
  statement String   @db.Text
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
}

model Agent {
  id        String     @id @default(uuid())
  projectId String
  type      AgentType
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runs      AgentRun[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([projectId, type])
}

model AgentRun {
  id          String       @id @default(uuid())
  projectId   String
  agentId     String
  workflowId  String
  step        Int
  type        AgentType
  input       Json
  output      Json?
  status      RunStatus    @default(PENDING)
  model       String?
  provider    String?
  error       String?      @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent       Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  events      AgentEvent[]
  approvals   ApprovalRequest[]
  executions  DeveloperExecution[]
  researchSession ResearchSession?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([workflowId, step])
  @@index([projectId, createdAt])
}

model AgentEvent {
  id        String   @id @default(uuid())
  runId     String
  kind      String
  message   String   @db.Text
  data      Json?
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([runId, createdAt])
}

model Task {
  id          String     @id @default(uuid())
  projectId   String
  title       String
  description String     @default("") @db.Text
  status      TaskStatus @default(TODO)
  sourceRunId String?
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions  DeveloperExecution[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([sourceRunId, title])
  @@index([projectId, status])
}

model Report {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  kind        String
  content     String   @db.Text
  sourceRunId String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceRunId, title])
  @@index([projectId, createdAt])
}

model Metric {
  id        String   @id @default(uuid())
  projectId String
  key       String
  label     String
  value     Float
  unit      String   @default("")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, key])
}

model Integration {
  id          String          @id @default(uuid())
  workspaceId String
  type        IntegrationType
  status      String          @default("CONNECTED")
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([workspaceId, type])
}

model GitHubRepository {
  id            String   @id @default(uuid())
  projectId     String   @unique
  githubId      BigInt
  fullName      String
  url           String
  defaultBranch String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  executions    DeveloperExecution[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ActivityEvent {
  id        String   @id @default(uuid())
  projectId String
  kind      String
  message   String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model ResearchSession {
  id          String         @id @default(uuid())
  projectId   String
  runId       String         @unique
  provider    String
  status      ResearchStatus
  summary     String         @default("") @db.Text
  limitations String         @default("") @db.Text
  queryCount  Int            @default(0)
  startedAt   DateTime       @default(now())
  completedAt DateTime       @default(now())
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run         AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  sources     ResearchSource[]
  findings    ResearchFinding[]

  @@index([projectId, startedAt])
}

model ResearchSource {
  id          String           @id @default(uuid())
  sessionId   String
  url         String           @db.Text
  title       String
  query       String
  excerpt     String           @db.Text
  retrievedAt DateTime
  session     ResearchSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  findings    ResearchFinding[]

  @@index([sessionId])
}

model ResearchFinding {
  id         String          @id @default(uuid())
  sessionId  String
  sourceId   String
  area       ResearchArea
  claim      String          @db.Text
  quote      String          @db.Text
  confidence String
  limitation String          @db.Text
  session    ResearchSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  source     ResearchSource  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sessionId, area])
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  projectId     String
  runId         String?
  executionId   String
  action        ApprovalAction
  round         Int            @default(0)
  status        ApprovalStatus @default(PENDING)
  description   String         @db.Text
  payload       Json
  requestedById String
  decidedById   String?
  requestedAt   DateTime       @default(now())
  decidedAt     DateTime?
  executedAt    DateTime?
  updatedAt     DateTime       @updatedAt
  error         String?        @db.Text
  baseSha       String?
  resultSha     String?
  failureSummary String?       @db.Text
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run           AgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  execution     DeveloperExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation("RequestedApprovals", fields: [requestedById], references: [id])
  decidedBy     User?          @relation("DecidedApprovals", fields: [decidedById], references: [id])

  @@unique([executionId, action, round])
  @@index([projectId, status, requestedAt])
}

model DeveloperExecution {
  id                String          @id @default(uuid())
  projectId         String
  runId             String?
  taskId            String?
  repositoryId      String
  repositoryGithubId BigInt
  repositoryFullName String
  status            DeveloperStatus @default(PROPOSED)
  proposal          Json
  inspectedPaths    Json            @default("[]")
  branch            String          @unique
  targetBranch      String
  baseSha           String
  commitSha         String?
  headSource        DeveloperHeadSource @default(FORGE)
  externalHeadSha   String?
  pullNumber        Int?
  pullUrl           String?
  pullState         String?
  validationSummary String?         @db.Text
  ciStatus          String          @default("UNAVAILABLE")
  ciSummary         String?         @db.Text
  ciChecks          Json?
  correctionCount   Int             @default(0)
  error             String?         @db.Text
  startedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repository        GitHubRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task              Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  run               AgentRun?       @relation(fields: [runId], references: [id], onDelete: SetNull)
  approvals         ApprovalRequest[]

  @@index([projectId, createdAt])
  @@unique([projectId, taskId])
}
